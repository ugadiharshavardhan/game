# Copy to .env.local. Everything prefixed VITE_ is sent to the browser: publishable keys only.

# Supabase → Project Settings → API. The publishable key, never the service-role/secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clerk → API keys. Supabase must trust this Clerk instance (README → Supabase setup).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
